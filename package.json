{
  "name": "blockman",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A faithful browser remake of Block-Man, the 1993 Soleau Software block-carrying puzzle game.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
